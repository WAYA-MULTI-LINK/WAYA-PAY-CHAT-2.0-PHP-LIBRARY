{
    "name": "wayaquick/payment-sdk",
    "description": "PHP client for the WayaPay Merchant API v2: collect, payout, accounts, identity, transactions.",
    "type": "library",
    "license": "MIT",
    "keywords": ["wayapay", "wayaquick", "payments", "payout", "collect", "bvn", "nigeria", "fintech"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WayaPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WayaPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "sample": "php samples/usage.php"
    },
    "config": {
        "sort-packages": true
    }
}